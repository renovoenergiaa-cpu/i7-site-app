# Environment Variables i7 - Inteligência Imobiliária

NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://i7_user:i7_password@localhost:5432/i7_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=i7_master_key_super_secret_2026

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=i7_admin
S3_SECRET_KEY=i7_minio_secret_key
S3_BUCKET_NAME=i7-media

# JWT Authentication
JWT_SECRET=i7_super_secret_jwt_key_2026_proptech
JWT_REFRESH_SECRET=i7_super_secret_refresh_jwt_key_2026

# Web Client URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api
