# ====================================================================
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO (SITE OFICIAL i7)
# ====================================================================

NODE_ENV=production

# 1. URL DA APLICAÇÃO & API
# Substitua pelo seu domínio oficial configurado na Vercel / Registro.br
NEXT_PUBLIC_APP_URL="https://i7imob.com.br"
NEXT_PUBLIC_API_URL="https://api.i7imob.com.br/api"

# 2. BANCO DE DADOS NA NUVEM (PostgreSQL via Supabase ou Neon)
# Crie seu projeto gratuito em supabase.com ou neon.tech e copie a URL de conexão:
DATABASE_URL="postgresql://postgres.[SEU_PROJETO]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[SEU_PROJETO]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# 3. INTEGRAÇÃO FINANCEIRA ASAAS (BOLETOS & PIX REAL)
# Chave de API de Produção gerada no painel do Asaas (Menu: Configurações -> Integrações)
ASAAS_ENVIRONMENT="PRODUCTION"
ASAAS_API_KEY="$aact_YTU5YTE0M2M6N2I4...[SUA_CHAVE_ASAAS_PRODUCAO]"
ASAAS_WALLET_ID="wal_[SEU_WALLET_ID]"
ASAAS_WEBHOOK_SECRET="whsec_[TOKEN_SECRETO_DO_WEBHOOK]"

# 4. ENVIO DE E-MAILS TRANSACIONAIS (RESEND)
# Crie sua chave gratuita em resend.com e autentique seu domínio i7imob.com.br
RESEND_API_KEY="re_123456789_abcdefg..."
MAIL_FROM="contato@i7imob.com.br"

# 5. SEGURANÇA JWT & SESSÕES
JWT_SECRET="i7_super_secret_jwt_key_producao_2026_change_me_to_random_hash"
JWT_REFRESH_SECRET="i7_super_secret_refresh_jwt_key_producao_2026_change_me"

# 6. ARMAZENAMENTO DE FOTOS E DOCUMENTOS (AWS S3 ou Supabase Storage)
STORAGE_PROVIDER="s3"
S3_BUCKET_NAME="i7-media-production"
S3_REGION="sa-east-1"
S3_ACCESS_KEY="AKIA..."
S3_SECRET_KEY="secret_key_aws..."
